        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "DERP current clients",
      "type": "timeseries",
      "datasource": {
