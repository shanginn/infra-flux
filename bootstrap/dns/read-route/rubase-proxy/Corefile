.:5353 {
    errors
    health :8080
    ready :8181
    prometheus :9153
    forward . ${MSK_VPN_ADDRESS}:5354 ${FIN_VPN_ADDRESS}:5354 {
        max_concurrent 64
        policy random
        health_check 2s no_rec domain health.test.
        max_fails 2
        failover SERVFAIL REFUSED
        failfast_all_unhealthy_upstreams
    }
}
