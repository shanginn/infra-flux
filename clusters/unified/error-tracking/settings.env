DJANGO_SETTINGS_MODULE=infra_settings
PYTHONPATH=/opt/infra:/code
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
HOME=/tmp
SKIP_INIT=true
DEBUG=false
ENABLE_TEST_API=false
GLITCHTIP_DOMAIN=https://errors.apps.shanginn.io
ALLOWED_HOSTS=errors.apps.shanginn.io,glitchtip-web,glitchtip-web.error-tracking.svc,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://errors.apps.shanginn.io
ENABLE_USER_REGISTRATION=false
ENABLE_SOCIAL_APPS_USER_REGISTRATION=false
ENABLE_ORGANIZATION_CREATION=false
GLITCHTIP_BOOTSTRAP_ADMIN_EMAIL=admin@errors.apps.shanginn.io
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
VALKEY_URL=
REDIS_URL=
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
EMAIL_ENABLED=false
GLITCHTIP_ENABLE_UPTIME=false
GLITCHTIP_ENABLE_LOGS=false
GLITCHTIP_ENABLE_MCP=false
GLITCHTIP_ENABLE_DUCKDB=false
GLITCHTIP_CHUNK_UPLOAD_USE_RELATIVE_URL=true
GLITCHTIP_RUST_INGEST=false
ENABLE_OBSERVABILITY_API=true
GLITCHTIP_RETENTION_DAYS=7
GLITCHTIP_EVENT_RETENTION_DAYS=7
GLITCHTIP_TRANSACTION_RETENTION_DAYS=7
GLITCHTIP_FILE_RETENTION_DAYS=7
GLITCHTIP_RELEASE_RETENTION_DAYS=7
PARTITION_HASH_BUCKETS=2
GLITCHTIP_MAX_UNZIPPED_PAYLOAD_SIZE=262144
DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
GLITCHTIP_MAX_UNZIPPED_ARCHIVE_SIZE=67108864
GLITCHTIP_MAX_ARCHIVE_MEMBERS=1000
GLITCHTIP_PII_SCRUB_DEFAULT={"enabled":true,"scrub_emails":true}
GRANIAN_WORKERS=1
GRANIAN_WORKERS_KILL_TIMEOUT=30
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=6
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_MAX_LIFETIME=300
VTASKS_CONCURRENCY=2
VTASKS_INGEST_CONCURRENCY=2
VTASKS_INGEST_BATCH_COUNT=10
LOG_LEVEL=WARNING
DEFAULT_FILE_STORAGE=storages.backends.s3.S3Storage
AWS_S3_USE_SSL=false
AWS_LOCATION=
GLITCHTIP_CAPACITY_BYTES=2147483648
