apps.shanginn.io:53 {
    errors
    file /zones/apps.db apps.shanginn.io {
        reload 1s
    }
    loadbalance
    health :8080
    ready :8181
    prometheus :9153
    reload 5s 1s
}

# Private synthetic health zones are never served through the public listener.
health.test:53 vibesites-dns-health.test:53 {
    template ANY ANY {
        rcode REFUSED
    }
}

# DS uses the parent/root chain; route the original QNAME through the same predicates.
shanginn.io:53 .:53 {
    errors
    template ANY ANY health.test vibesites-dns-health.test {
        rcode REFUSED
    }
    forward . 10.120.53.54:53 {
        except shanginn.ru shanginn.io xn--80alfarbic0a3a.xn--p1ai xn--b1abcbftdmxceabz.xn--p1ai xn--80afga3bt4c.xn--p1ai generach.ru xn--e1afqnbgc.xn--p1ai sistent.ru sputi.ru xn--80ahnllf1ado3f.xn--p1ai xn--80aakfartrcj1ct.xn--p1ai mystaro.ru xn--80ajijindid5e.xn--p1ai itaisolutions.ru vibesites.ru xn--80aacc0bc7ayl4g.xn--p1ai flowerswork.ru flowerworks.ru xn--80aafk8cdei3c.xn--p1ai shanghaiauto.ru aufstaff.ru xn--80aao3bdhk2b9b.xn--p1ai
        max_concurrent 256
        health_check 2s no_rec domain health.test.
        max_fails 2
        failfast_all_unhealthy_upstreams
    }
    # Only the excluded BIND suffixes reach this handler. NXDOMAIN does not fall through.
    forward . 10.120.53.53:53 {
        max_concurrent 256
        health_check 5s no_rec domain shanginn.io.
    }
    prometheus :9153
}
