apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - upstream-calico.yaml
patches:
  - target:
      kind: ConfigMap
      name: calico-config
      namespace: kube-system
    patch: |-
      apiVersion: v1
      kind: ConfigMap
      metadata:
        name: calico-config
        namespace: kube-system
      data:
        calico_backend: vxlan
        veth_mtu: "1230"
  - target:
      kind: DaemonSet
      name: calico-node
      namespace: kube-system
    patch: |-
      apiVersion: apps/v1
      kind: DaemonSet
      metadata:
        name: calico-node
        namespace: kube-system
      spec:
        template:
          spec:
            containers:
              - name: calico-node
                env:
                  - name: CLUSTER_TYPE
                    value: k8s
                  - name: IP_AUTODETECTION_METHOD
                    value: interface=tailscale0
                  - name: CALICO_IPV4POOL_CIDR
                    value: {{ unified_pod_cidr | to_json }}
                  - name: CALICO_IPV4POOL_IPIP
                    value: Never
                  - name: CALICO_IPV4POOL_VXLAN
                    value: Always
                  - name: FELIX_IPINIPENABLED
                    value: "false"
                  - name: FELIX_IPV6SUPPORT
                    value: "false"
                  - name: FELIX_WIREGUARDENABLED
                    value: "false"
                readinessProbe:
                  exec:
                    command: [calico, component, node, health, --felix-ready]
                livenessProbe:
                  exec:
                    command: [calico, component, node, health, --felix-live]
                resources:
                  requests:
                    cpu: 250m
                    memory: 256Mi
