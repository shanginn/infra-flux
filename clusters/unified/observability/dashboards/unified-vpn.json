{
  "uid": "unified-vpn",
  "title": "VPN and coordinator endpoints",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "unified",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus replica",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus replica [01]$/",
        "current": {
          "text": "Prometheus replica 0",
          "value": "prometheus-0"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{job=\"node-exporter\"}, node)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Reading this dashboard",
      "options": {
        "mode": "markdown",
        "content": "No direct-vs-DERP or public-IP-change proof is inferred from interface byte counters. Dedicated packet probes and controlled failure tests are separate evidence.\n\nData source selection is explicit. Each Prometheus keeps its own history; replica 1 does not fill gaps in replica 0. Missing series show **No data**, never an invented zero. Refresh is one minute."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "title": "Headscale / DERP HTTPS availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "HTTPS check only: it does not prove DERP payload transport.",
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=~\"headscale-https|derp-.*-https\"}",
          "legendFormat": "{{job}} from {{probe_node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "HTTPS probe duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "probe_duration_seconds{job=~\"headscale-https|derp-.*-https\"}",
          "legendFormat": "{{job}} from {{probe_node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "TLS certificate remaining",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "probe_ssl_earliest_cert_expiry{job=~\"headscale-https|derp-.*-https\"}-time()",
          "legendFormat": "{{job}} from {{probe_node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "VPN receive",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{node=~\"$node\",device=\"tailscale0\"}[$__rate_interval])",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "VPN transmit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_transmit_bytes_total{node=~\"$node\",device=\"tailscale0\"}[$__rate_interval])",
