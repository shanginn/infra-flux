{
  "uid": "unified-postgres",
  "title": "PostgreSQL replication and storage",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "unified",
    "provisioned"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus (HA|replica [01])$/",
        "current": {
          "text": "Prometheus HA",
          "value": "prometheus-ha"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(up{job=\"node-exporter\"}, node)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$datasource"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Reading this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Patroni uses required watchdog fencing. The graph cannot establish continuous absence of dual-primary during a network partition; independent local proof is still needed.\n\nPrometheus HA routes new connections to a Ready replica. An in-flight request may still fail during a loss; retry or refresh. Each replica keeps its own history, so this does not merge historical gaps. Choose a direct replica for consistent diagnostic history. Missing series show **No data**, never an invented zero. Refresh is one minute."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "id": 1
    },
    {
      "title": "Current primary by node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "One expected primary; asynchronous replicas do not guarantee zero lost transactions.",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_primary{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Streaming asynchronous replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_async_replicas{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Maximum replay lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_max_replay_lag_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Physical PGDATA and WAL budget",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "24 GiB logical PGDATA budget per node includes WAL. Warning18GiB/critical21GiB; not filesystem quota.",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_data_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "WAL bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "6/8GiB warning/critical; replication slot bound is checked around checkpoints, not a hard disk cap.",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_wal_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Lost replication slots",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_lost_slots{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Age of last successful full metric collection",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "SQL values disappear on failed collection; do not assume old values remain current.",
      "targets": [
        {
          "refId": "A",
          "expr": "time()-infra_postgres_last_success_timestamp_seconds{node=~\"$node\"}",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Database TLS certificate remaining",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "infra_postgres_tls_expiry_timestamp_seconds{node=~\"$node\"}-time()",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      }
    }
  ]
}
