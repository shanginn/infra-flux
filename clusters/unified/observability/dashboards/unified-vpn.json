            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Node network errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_errs_total{node=~\"$node\",device=\"tailscale0\"}[$__rate_interval])+rate(node_network_transmit_errs_total{node=~\"$node\",device=\"tailscale0\"}[$__rate_interval])",
          "legendFormat": "{{node}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
