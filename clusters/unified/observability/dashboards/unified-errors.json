{
  "uid": "unified-errors",
  "title": "Application error tracking",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "unified",
    "provisioned",
    "errors"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus replica",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus replica [01]$/",
        "current": {
          "text": "Prometheus replica 0",
          "value": "prometheus-0"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "Reading this dashboard",
      "options": {
        "mode": "markdown",
        "content": "[Open GlitchTip](https://errors.apps.shanginn.io) for application exceptions. Applications must configure their SDK/DSN; a healthy service or an empty queue does not prove exception delivery. The capacity guard is a periodic ingestion gate, not a physical PostgreSQL quota. It stays latched after its threshold is crossed until explicit operator review. Shared database/queue gauges use max across replicas; per-worker counters are summed. Missing series show **No data**, not zero errors. Select one Prometheus history explicitly."
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "id": 1
    },
    {
      "title": "Scrape availability (two web, two workers)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "A successful scrape proves the metrics endpoint responded, not successful application error ingestion.",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"glitchtip\"}",
          "legendFormat": "{{component}} {{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Ready replicas by component",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Expected two available replicas per deployment. KSM replicas are deduplicated with max.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(deployment)(kube_deployment_status_replicas_available{namespace=\"error-tracking\",deployment=~\"glitchtip-web|glitchtip-worker\"})",
          "legendFormat": "{{deployment}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Database size and guard threshold",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Shared DB-level values, not the sum of two web scrapes. Retention and a periodic guard are not a filesystem hard quota.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(glitchtip_capacity_guard_database_bytes{job=\"glitchtip\",component=\"web\"})",
          "legendFormat": "Database",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(glitchtip_capacity_guard_threshold_bytes{job=\"glitchtip\",component=\"web\"})",
          "legendFormat": "Ingestion threshold",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Last successful guard age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Uses the oldest guard timestamp among healthy web scrapes. Above three minutes needs investigation. If the guard is unavailable, it cannot close ingestion.",
      "targets": [
        {
          "refId": "A",
          "expr": "time()-min(glitchtip_capacity_guard_last_success_timestamp_seconds{job=\"glitchtip\",component=\"web\"} and on(instance) (up{job=\"glitchtip\",component=\"web\"} == 1))",
          "legendFormat": "Guard age",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Ingestion guard latched",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "One means the storage guard has closed ingestion. It does not reopen automatically after space is freed.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(glitchtip_capacity_guard_latched{job=\"glitchtip\",component=\"web\"})",
          "legendFormat": "Latched",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Organizations closed by guard",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Shared database gauge; do not sum web replicas.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(glitchtip_capacity_guard_closed_organizations{job=\"glitchtip\",component=\"web\"})",
          "legendFormat": "Closed organizations",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Approximate waiting tasks by queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Each worker observes the shared queue. Max avoids counting the same backlog twice. Zero queue depth does not establish delivery.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by(queue)(vtasks_queue_depth{job=\"glitchtip\",component=\"worker\"})",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Tasks currently processing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Per-worker active task gauges are summed.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(queue)(vtasks_active_tasks{job=\"glitchtip\",component=\"worker\"})",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Task completion rate by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Counters may be absent before the first task. Outcome labels come from the worker, not inferred from HTTP acceptance.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status)(rate(vtasks_tasks_processed_total{job=\"glitchtip\",component=\"worker\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Task execution p95 (10 minutes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Interpret only alongside sample count; low activity does not produce a reliable latency estimate.",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(queue,le)(rate(vtasks_task_duration_seconds_bucket{job=\"glitchtip\",component=\"worker\"}[10m])))",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Task duration observations (10 minutes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Sample count for the adjacent execution-latency panel.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(queue)(increase(vtasks_task_duration_seconds_count{job=\"glitchtip\",component=\"worker\"}[10m]))",
          "legendFormat": "{{queue}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Exporter process resident memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Metrics describe the exporting process. Use the Kubernetes workload dashboard for total container working set.",
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"glitchtip\"}",
          "legendFormat": "{{component}} {{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Exporter process CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "CPU seconds per second for the exporter process, not a sum of all web child processes.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"glitchtip\"}[$__rate_interval])",
          "legendFormat": "{{component}} {{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Exporter process age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "description": "Process restart evidence is separate from request availability and application delivery.",
      "targets": [
        {
          "refId": "A",
          "expr": "time()-process_start_time_seconds{job=\"glitchtip\"}",
          "legendFormat": "{{component}} {{pod}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 52,
        "w": 12,
        "h": 8
      }
    }
  ]
}
